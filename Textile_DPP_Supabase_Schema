-- Textile Digital Product Passport database schema
-- Owner: Arman
-- Target: Supabase / PostgreSQL 15+
-- Purpose: implement the 49-field textile DPP working dataset supplied by the team.
-- IMPORTANT: the May 2026 JRC textile DPP report is preparatory; the final delegated act may change mandatory fields.

create extension if not exists pgcrypto;

create type dpp_access_level as enum ('public','legitimate_interest','restricted','authority_only');
create type operator_type as enum ('manufacturer','importer','other_responsible');
create type evidence_type as enum (
  'mechanical_conformity','recyclability_conformity','recycled_content_conformity',
  'organic_content_conformity','footprint_conformity','other'
);
create type verification_status as enum ('unverified','supplier_declared','verified','expired','rejected');

create table operators (
  operator_id uuid primary key default gen_random_uuid(),
  operator_type operator_type not null,
  external_operator_id text not null,
  name text not null,
  postal_address text,
  contact_info text,
  country_code char(2),
  created_at timestamptz not null default now(),
  unique(operator_type, external_operator_id)
);

create table facilities (
  facility_id uuid primary key default gen_random_uuid(),
  external_facility_id text not null unique,
  facility_name text,
  postal_address text,
  country_code char(2),
  created_at timestamptz not null default now()
);

create table products (
  product_id uuid primary key default gen_random_uuid(),
  model_id text not null unique,
  manufacturer_operator_id uuid not null references operators(operator_id),
  espr_product_category text,
  pefcr_product_category text,
  hs_code varchar(6) check (hs_code is null or hs_code ~ '^[0-9]{6}$'),
  taric_code varchar(10) check (taric_code is null or taric_code ~ '^[0-9]{10}$'),
  product_weight_kg numeric(12,4) check (product_weight_kg is null or product_weight_kg > 0),
  robustness_score numeric(8,3),
  eu_ecolabel_status boolean,
  care_instructions text,
  repair_instructions text,
  warranty_months integer check (warranty_months is null or warranty_months >= 0),
  recyclability_score numeric(8,3),
  environmental_footprint_performance text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table batches (
  batch_uuid uuid primary key default gen_random_uuid(),
  batch_id text not null unique,
  product_id uuid not null references products(product_id) on delete cascade,
  manufacturing_facility_id uuid references facilities(facility_id),
  importer_operator_id uuid references operators(operator_id),
  other_responsible_operator_id uuid references operators(operator_id),
  country_of_origin char(2),
  manufacturing_date date check (manufacturing_date is null or manufacturing_date <= current_date),
  organic_content_pct numeric(5,2) check (organic_content_pct is null or organic_content_pct between 0 and 100),
  organic_material_amount_kg numeric(12,4) check (organic_material_amount_kg is null or organic_material_amount_kg >= 0),
  weight_excluding_trims_kg numeric(12,4) check (weight_excluding_trims_kg is null or weight_excluding_trims_kg > 0),
  recycled_content_pct numeric(5,2) check (recycled_content_pct is null or recycled_content_pct between 0 and 100),
  recycled_material_amount_kg numeric(12,4) check (recycled_material_amount_kg is null or recycled_material_amount_kg >= 0),
  recycled_content_origin_type text,
  safe_use_instructions text,
  end_of_life_disassembly_info text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table items (
  item_id uuid primary key default gen_random_uuid(),
  batch_uuid uuid not null references batches(batch_uuid) on delete cascade,
  unique_product_id text not null unique,
  created_at timestamptz not null default now()
);

create table fibre_composition (
  fibre_id uuid primary key default gen_random_uuid(),
  product_id uuid not null references products(product_id) on delete cascade,
  fibre_name text not null,
  percentage numeric(5,2) not null check (percentage > 0 and percentage <= 100),
  created_at timestamptz not null default now(),
  unique(product_id, fibre_name)
);

create table components (
  component_id uuid primary key default gen_random_uuid(),
  product_id uuid not null references products(product_id) on delete cascade,
  component_ref text,
  component_name text not null,
  specification text,
  created_at timestamptz not null default now()
);

create table substances_of_concern (
  substance_id uuid primary key default gen_random_uuid(),
  product_id uuid not null references products(product_id) on delete cascade,
  batch_uuid uuid references batches(batch_uuid) on delete cascade,
  substance_name_code text not null,
  location_in_product text,
  concentration_pct_ww numeric(8,4) check (concentration_pct_ww is null or concentration_pct_ww between 0 and 100),
  created_at timestamptz not null default now()
);

create table mechanical_tests (
  test_id uuid primary key default gen_random_uuid(),
  product_id uuid not null references products(product_id) on delete cascade,
  batch_uuid uuid references batches(batch_uuid) on delete cascade,
  visual_inspection_result numeric(10,3),
  spirality_pct numeric(8,3),
  dimensional_change_pct numeric(8,3),
  test_date date,
  test_standard text,
  created_at timestamptz not null default now()
);

create table evidence_documents (
  evidence_id uuid primary key default gen_random_uuid(),
  product_id uuid not null references products(product_id) on delete cascade,
  batch_uuid uuid references batches(batch_uuid) on delete cascade,
  evidence_type evidence_type not null,
  document_url text not null,
  source_issuer text,
  verification_status verification_status not null default 'unverified',
  issued_date date,
  expiry_date date,
  last_verified date,
  owner text,
  notes text,
  created_at timestamptz not null default now(),
  check (expiry_date is null or issued_date is null or expiry_date >= issued_date)
);

-- Metadata table: preserves the team's full 49-field specification and drives UI/API behaviour.
create table dpp_field_catalog (
  field_id varchar(7) primary key,
  business_category text not null,
  data_field text not null,
  source_data_type text not null,
  granularity text not null,
  unit text,
  regulatory_status text,
  proposed_access text not null,
  definition_guidance text,
  physical_mapping text not null,
  active boolean not null default true,
  schema_version integer not null default 1
);

-- Change history for auditable updates/versioning.
create table dpp_audit_log (
  audit_id bigserial primary key,
  entity_table text not null,
  entity_id text not null,
  action text not null check (action in ('INSERT','UPDATE','DELETE','VERIFY','STATUS_CHANGE')),
  changed_by uuid,
  changed_at timestamptz not null default now(),
  old_data jsonb,
  new_data jsonb
);

create index idx_batches_product on batches(product_id);
create index idx_items_batch on items(batch_uuid);
create index idx_fibre_product on fibre_composition(product_id);
create index idx_components_product on components(product_id);
create index idx_soc_product_batch on substances_of_concern(product_id,batch_uuid);
create index idx_tests_product_batch on mechanical_tests(product_id,batch_uuid);
create index idx_evidence_product_batch on evidence_documents(product_id,batch_uuid);

-- Useful public view. Sensitive contacts, facility data and verification-only evidence are excluded.
create view public_dpp_summary as
select
  p.model_id,
  b.batch_id,
  i.unique_product_id,
  p.espr_product_category,
  p.pefcr_product_category,
  p.hs_code,
  p.taric_code,
  m.external_operator_id as manufacturer_id,
  m.name as manufacturer_name,
  imp.external_operator_id as importer_id,
  imp.name as importer_name,
  b.country_of_origin,
  p.robustness_score,
  p.eu_ecolabel_status,
  p.care_instructions,
  p.repair_instructions,
  p.warranty_months,
  p.recyclability_score,
  b.recycled_content_pct,
  b.recycled_content_origin_type,
  b.organic_content_pct,
  p.environmental_footprint_performance
from products p
join operators m on m.operator_id = p.manufacturer_operator_id
join batches b on b.product_id = p.product_id
left join items i on i.batch_uuid = b.batch_uuid
left join operators imp on imp.operator_id = b.importer_operator_id;


